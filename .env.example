# Copy to backend/.env and adjust. No secrets belong in this file.
# All settings use the SHC_ prefix.

# Network binding. Keep 127.0.0.1 unless you have set up authenticated remote access.
SHC_HOST=127.0.0.1
SHC_PORT=3000
# Must be true to bind to anything other than loopback.
SHC_ALLOW_REMOTE=false
# Extra Host header values accepted besides 127.0.0.1 / localhost (JSON list), e.g. a Tailscale name.
SHC_ALLOWED_HOSTS=[]

# Where the database, API token and logs live. Default: %LOCALAPPDATA%\SmartHomeControl
# SHC_DATA_DIR=C:\Users\you\AppData\Local\SmartHomeControl

SHC_LOG_LEVEL=INFO

# Device providers to load (JSON list): "govee_lan", "ewelink_lan", "yeelight_lan" (Xiaomi/Yeelight).
SHC_ENABLED_PROVIDERS=["govee_lan","ewelink_lan","yeelight_lan"]
# PC LAN IPv4 used for multicast discovery; auto-detected when unset.
# SHC_LAN_INTERFACE_IP=192.168.1.19

# Timing (seconds)
SHC_COMMAND_TIMEOUT_S=5.0
SHC_POLL_INTERVAL_S=30
# Poll devices without push (Govee) even with no dashboard open; needed to log changes made elsewhere.
SHC_POLL_ALWAYS=true
SHC_STATE_MAX_AGE_S=5
SHC_OFFLINE_AFTER_FAILURES=3
